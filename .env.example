OPENAI_API_KEY=your_openai_api_key

# Streamlit -> FastAPI
CHURN_API_URL=http://127.0.0.1:8000

# Retrieval mode:
#
# rules
#   Fast default.
#   Does not load SentenceTransformer / torch / Qdrant.
#
# semantic
#   Semantic policy retrieval using
#   SentenceTransformer + Qdrant.
RETRIEVAL_MODE=rules

# HTTP client timeouts in seconds
API_CONNECT_TIMEOUT=3
API_READ_TIMEOUT=90
API_WRITE_TIMEOUT=10
API_POOL_TIMEOUT=5